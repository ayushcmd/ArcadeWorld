{# brand-mark.njk — ArcadeWorld wordmark + planetary arcade gaming glyph.
   Reused in header, footer, and navigation.
   Variables:
     wordmark_class — classes applied to the wordmark span (default size set by caller)
     glyph_class    — classes applied to the svg (default w-8 h-8)
 #}
<a href="/" class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-lime-400 rounded-lg" aria-label="ArcadeWorld Home">
    <svg class="{{ glyph_class or 'w-8 h-8' }} shrink-0 transition-transform duration-200 group-hover:scale-105" viewBox="0 0 100 100" fill="none" aria-hidden="true">
        <defs>
            <radialGradient id="markSphere" cx="40%" cy="35%" r="65%">
                <stop offset="0%" stop-color="#262C34"/>
                <stop offset="70%" stop-color="#17191C"/>
                <stop offset="100%" stop-color="#0E1012"/>
            </radialGradient>
            <linearGradient id="markLime" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#D4FF70"/>
                <stop offset="100%" stop-color="#B7F34A"/>
            </linearGradient>
            <linearGradient id="markRed" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FF8E8E"/>
                <stop offset="100%" stop-color="#FF6B6B"/>
            </linearGradient>
        </defs>

        <!-- Circular Planet Sphere -->
        <circle cx="50" cy="50" r="42" fill="url(#markSphere)" stroke="#2F3642" stroke-width="2.5"/>

        <!-- Orbit Grid Latitude Line -->
        <path d="M 12 50 A 38 14 0 0 0 88 50 A 38 14 0 0 0 12 50 Z" stroke="#363E4D" stroke-width="1.2" stroke-dasharray="3 3" fill="none"/>

        <!-- Longitude Arc -->
        <ellipse cx="50" cy="50" rx="18" ry="42" stroke="#363E4D" stroke-width="1.2" stroke-dasharray="3 3" fill="none"/>

        <!-- Back Half Ring -->
        <path d="M 10 42 C 16 28, 76 22, 92 36" stroke="#252A33" stroke-width="3" stroke-linecap="round" fill="none"/>

        <!-- Integrated Arcade D-Pad -->
        <rect x="36" y="27" width="12" height="34" rx="3.5" fill="url(#markLime)"/>
        <rect x="25" y="38" width="34" height="12" rx="3.5" fill="url(#markLime)"/>
        <circle cx="42" cy="44" r="3" fill="#17191C"/>

        <!-- Action Buttons (A & B) -->
        <circle cx="65" cy="52" r="5.5" fill="url(#markRed)"/>
        <circle cx="73" cy="41" r="5.5" fill="url(#markRed)"/>

        <!-- Dynamic Front Orbital Arc -->
        <path d="M 8 54 C 18 76, 78 78, 94 56" stroke="url(#markLime)" stroke-width="3.8" stroke-linecap="round" fill="none"/>
        <circle cx="86" cy="62" r="2.8" fill="#B7F34A"/>
    </svg>
    <span class="font-display font-bold tracking-tight {{ wordmark_class or 'text-xl' }} text-paper">
        Arcade<span class="text-[var(--color-primary)]">World</span>
    </span>
</a>
